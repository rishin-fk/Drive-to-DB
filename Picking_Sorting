/**
 * LOCATION / TIME / PICKER / SORTING MAPPER
 * ------------------------------------------------------------------
 * - Bound to master sheet: 19H011e8xKfAc4DrRa_vLwoM__XsT0eMaYzn5pEfi7Xo
 * - Destination tabs are day-wise (e.g. "14th Aug" = MTD, "15th Aug", ...).
 * - Tab key: Box ID = col D, FSN = col F (unchanged from prior version).
 *
 * - PICKING source files (CSV / Google Sheet) in DRIVE_FOLDER_ID are read by
 *   FIXED column position (row 1 = header, skipped; no header-name detection):
 *     H = Box ID        D = FSN         N = Sorted Box (fallback key)
 *     M = Picking Location   J = Picking Time   I = Picker
 *     Q = Sorted Station     P = Sorting BIN    O = Sorting Time   R = Sorter
 *   Primary match: source(H,D) -> tab(D,F)
 *   Fallback match (only for rows primary didn't hit): source(N,D) -> tab(D,F)
 *   This source always supplies Y/Z/AA (Picking Location/Time/Picker), and
 *   also acts as the FALLBACK supplier for AB/AC/AE (not AD) when the SORTING
 *   source folder below has no match for a row.
 *
 * - SORTING source files in SORTING_DRIVE_FOLDER_ID are read by FIXED column
 *   position (row 1 = header, skipped):
 *     A = Box ID   I = FSN
 *     AB = Sorted Station   Q = Sorting BIN   G = Sorting Time   U = Sorter
 *   Primary match only: source(A,I) -> tab(D,F). No fallback key for this
 *   source. This is the PRIMARY supplier for AB/AC/AD/AE.
 *
 * - Writes: Y=Picking Location, Z=Picking Time, AA=Picker,
 *           AB=Sorted Station, AC=Sorting BIN, AD=Sorting Time, AE=Sorter
 *   Resolution order per row:
 *     Y/Z/AA        <- PICKING source only
 *     AB, AC, AE    <- SORTING source if matched, else PICKING source fallback
 *     AD            <- SORTING source only; if unmatched, retain existing value
 *                      (no fallback to PICKING source's Sorting Time)
 * - Unmatched tab rows keep their existing Y:AE values untouched.
 * ------------------------------------------------------------------
 */

const CONFIG = {
  MASTER_SHEET_ID: '19H011e8xKfAc4DrRa_vLwoM__XsT0eMaYzn5pEfi7Xo',
  DRIVE_FOLDER_ID: '1ZODejxkhlRJk9OqyzgXRzezGAHLC57ZI',
  SORTING_DRIVE_FOLDER_ID: '13ClZXG-VvOC6gJfvAV1HKNmaZjGjMIRt',
  BACKFILL_START: '2026-08-14',

  TAB: {
    BOXID_COL: 4,   // D
    FSN_COL: 6,     // F
    START_ROW: 2,
    // Destination write range: Y through AE (7 contiguous columns)
    WRITE_START_COL: 25, // Y
    WRITE_NUM_COLS: 7    // Y, Z, AA, AB, AC, AD, AE
  },

  // Fixed-position PICKING source columns (0-based indices into the parsed row array)
  SOURCE: {
    BOX_COL: 7,           // H
    FSN_COL: 3,           // D
    SORTED_BOX_COL: 13,   // N
    PICKING_LOCATION_COL: 12, // M
    PICKING_TIME_COL: 9,      // J
    PICKER_COL: 8,            // I
    SORTED_STATION_COL: 16,   // Q
    SORTING_BIN_COL: 15,      // P
    SORTING_TIME_COL: 14,     // O
    SORTER_COL: 17            // R
  },

  // Fixed-position SORTING source columns (0-based indices into the parsed row array)
  SORTING_SOURCE: {
    BOX_COL: 0,           // A
    FSN_COL: 8,           // I
    SORTED_STATION_COL: 27, // AB
    SORTING_BIN_COL: 16,    // Q
    SORTING_TIME_COL: 6,    // G
    SORTER_COL: 20          // U
  },

  LOG_SHEET_NAME: 'Automation_Log'
};

// Compute fixed source widths once, outside the per-row parsing loops.
const PICKING_WIDTH_ = Math.max(...Object.keys(CONFIG.SOURCE).map(k => CONFIG.SOURCE[k])) + 1;
const SORTING_WIDTH_ = Math.max(...Object.keys(CONFIG.SORTING_SOURCE).map(k => CONFIG.SORTING_SOURCE[k])) + 1;

const MONTHS = {
  jan: 1, january: 1, feb: 2, february: 2, mar: 3, march: 3,
  apr: 4, april: 4, may: 5, jun: 6, june: 6, jul: 7, july: 7,
  aug: 8, august: 8, sep: 9, sept: 9, september: 9,
  oct: 10, october: 10, nov: 11, november: 11, dec: 12, december: 12
};

