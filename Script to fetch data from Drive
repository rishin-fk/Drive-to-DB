// ---------- Auto-detect backfill start date ----------
// Scans all tabs in this spreadsheet, parses date-named ones (e.g. "9th July"),
// and returns the earliest date found. Falls back to CONFIG.BACKFILL_START
// if no date-named tabs exist yet (e.g. brand-new duplicate sheet).

function getEarliestTabStart(ss) {
  const dates = ss.getSheets()
    .map(sheet => parseTabDate(sheet.getName()))
    .filter(d => d);

  if (dates.length === 0) {
    Logger.log('No date-named tabs found -- falling back to CONFIG.BACKFILL_START (' + CONFIG.BACKFILL_START + ').');
    return new Date(CONFIG.BACKFILL_START);
  }

  const earliest = new Date(Math.min.apply(null, dates));
  Logger.log('Auto-detected earliest date-named tab: ' + earliest.toDateString());
  return earliest;
}

// ---------- Combined (Location + Time + Picker ID + AB + AC + AH) ----------

function runBackfill() {
  const ss = getMasterSpreadsheet();
  const start = getEarliestTabStart(ss);
  const end = new Date();
  const tabs = getTabsInRange(ss, start, end);

  executeMapping(ss, tabs, 'BACKFILL');
}

function runDaily() {
  const ss = getMasterSpreadsheet();
  // Tab-selection window (unchanged): only refresh day-tabs from the last
  // LOOKBACK_DAYS days. This does NOT affect which source files get scanned.
  const start = new Date();
  start.setDate(start.getDate() - CONFIG.LOOKBACK_DAYS);
  const end = new Date();
  const tabs = getTabsInRange(ss, start, end);

  executeMapping(ss, tabs, 'DAILY');
}

function setupDailyTrigger() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'runDaily') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('runDaily').timeBased().atHour(10).everyDays(1).create();
  notify_('Daily trigger installed: runs every day around 10 AM.');
}

// ---------- Standalone Picker ID (independent, same tab/date-range logic) ----------

function runPickerBackfill() {
  const ss = getMasterSpreadsheet();
  const start = getEarliestTabStart(ss);
  const end = new Date();
  const tabs = getTabsInRange(ss, start, end);

  executePickerMapping(ss, tabs, 'PICKER_BACKFILL');
}

function runPickerDaily() {
