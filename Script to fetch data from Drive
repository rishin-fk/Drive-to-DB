// ---------- Sheet Access Helper ----------

function getMasterSpreadsheet() {
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active && active.getId() === CONFIG.MASTER_SHEET_ID) {
    return active;
  }
  return SpreadsheetApp.openById(CONFIG.MASTER_SHEET_ID);
}

